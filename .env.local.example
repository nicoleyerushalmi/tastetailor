# Copy to .env.local and fill in values. Never commit .env.local.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional — needed for DB-04 (create/delete throwaway auth user in E2E)
SUPABASE_SERVICE_ROLE_KEY=

# AI provider: mock | gemini
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional (OpenAI adapter not shipped yet)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Daily generation limit per user (used by /api/generate)
GENERATIONS_PER_DAY=20

# Verbose Gemini / API attempt logs in the Next server console (1|true)
AI_DEBUG=

# Unsplash (optional) — recipe photos on generate; omit to use ambient fallbacks
UNSPLASH_ACCESS_KEY=

# Playwright E2E (optional overrides; defaults are the local test accounts)
E2E_EMAIL=
E2E_PASSWORD=
E2E_EMAIL_B=
E2E_PASSWORD_B=

# Opt-in live smoke (`npm run test:live`) — uses Gemini (+ Unsplash for FEAT-16)
# Not part of default CI / npm run test:e2e
# Prerequisites: GEMINI_API_KEY (required); UNSPLASH_ACCESS_KEY (FEAT-16); free port 3000
# AI_PROVIDER is forced to gemini by playwright.live.config.ts when that script runs
